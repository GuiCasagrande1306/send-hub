# =====================================================================
# SEND HUB — variáveis de ambiente
# Copie para `.env.local` e preencha. SEM nenhuma delas o sistema sobe
# em MODO DEMO, com dataset de exemplo e autenticação desligada.
#
# ⚠️ NÃO REAPROVEITE VALORES DE OUTRA INSTALAÇÃO DESTE PAINEL.
# Esta é uma instalação independente e precisa de credenciais próprias.
# Três variáveis fazem estrago silencioso se vierem copiadas:
#
#   NEXT_PUBLIC_SUPABASE_* / SERVICE_ROLE  → escreveriam no banco alheio.
#   NEXT_PUBLIC_APP_URL                    → define os `redirect_uri` do
#     OAuth de Meta e Google. Apontando para o outro domínio, o usuário
#     consente aqui e o token é gravado lá.
#   CRON_SECRET                            → além de proteger /api/sync/*,
#     é a chave HMAC do `state` do OAuth. Repetida, um painel consegue
#     vincular conta de anúncios no outro.
# =====================================================================

# --- Supabase --------------------------------------------------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️ Ignora RLS por completo. Só no servidor, nunca no browser, nunca
# commitada. Usada por: sync de métricas, upload de PDF e leitura de
# `integration_secrets`.
SUPABASE_SERVICE_ROLE_KEY=

# Força o modo demo mesmo com Supabase configurado (útil para demonstração).
# NEXT_PUBLIC_DEMO_MODE=1

NEXT_PUBLIC_APP_URL=http://localhost:5212

# --- Meta Ads (Graph API) -------------------------------------------
# developers.facebook.com → seu app → Configurações Básicas
# Permissões necessárias: ads_read, ads_management, business_management
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0

# --- Google Ads API --------------------------------------------------
# O developer token exige aprovação do Google; até sair, ele responde
# apenas para contas de teste.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# ID da MCC (sem hífens), usada como login-customer-id
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- WhatsApp --------------------------------------------------------
# "cloud_api"  → API oficial da Meta. Exige template aprovado para
#                iniciar conversa fora da janela de 24h.
# "evolution"  → Evolution API (não oficial). Sem template, porém com
#                risco de bloqueio do número.
WHATSAPP_PROVIDER=cloud_api

# Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Nome do template aprovado para envio de relatório
WHATSAPP_TEMPLATE_NAME=relatorio_mensal
WHATSAPP_TEMPLATE_LANG=pt_BR

# Evolution API (open-source, sobre Baileys — sem custo por mensagem e
# com suporte a envio de mídia para grupos @g.us)
EVOLUTION_API_URL=https://sua-evolution.exemplo.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=send-hub

# Formato do corpo de sendMedia. "v2" (padrão) usa payload PLANO;
# "v1" usa o aninhado com options/mediaMessage. Mandar o formato errado
# NÃO gera erro claro — o servidor responde 400 genérico ou aceita e não
# envia nada. Confira a versão da sua instância antes de mudar.
EVOLUTION_API_VERSION=v2

# --- Geração de PDF --------------------------------------------------
# "react-pdf" → roda em qualquer runtime Node, inclusive serverless.
# "puppeteer" → fidelidade visual maior (renderiza a rota HTML do
#               relatório), mas exige Chromium no ambiente.
PDF_ENGINE=react-pdf

# --- Jobs ------------------------------------------------------------
# Protege /api/sync/* contra chamadas externas.
CRON_SECRET=

# --- Webhook de pagamentos -------------------------------------------
# Token que o gateway envia no header `asaas-access-token`. Definido por
# você no painel do Asaas e repetido aqui — é a ÚNICA proteção do
# endpoint, que é público por natureza (o gateway não faz login).
PAYMENTS_WEBHOOK_TOKEN=
